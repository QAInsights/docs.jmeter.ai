{
  "name": "jmeter-docs",
  "type": "module",
  "version": "1.0.0",
  "description": "Community documentation site for Apache JMeter",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.18.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run lint && node scripts/generate-release-pages.mjs && node scripts/generate-llms-full.mjs && node scripts/generate-llms-chunks.mjs && node scripts/generate-og-images.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "convert": "node tools/convert.mjs",
    "generate-sidebar": "node scripts/generate-sidebar.mjs",
    "generate-release-pages": "node scripts/generate-release-pages.mjs",
    "generate-llms-full": "node scripts/generate-llms-full.mjs",
    "generate-llms-chunks": "node scripts/generate-llms-chunks.mjs",
    "lint": "vitest run tests/unit/schema-validation.test.mjs tests/unit/seo-validation.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.8",
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "14.2.1",
    "@astrojs/starlight": "^0.41.0",
    "@astrojs/starlight-docsearch": "^0.7.0",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/lora": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.15",
    "astro": "^7.2.2",
    "highlight.js": "^11.11.1",
    "lucode-starlight": "^0.1.6",
    "marked": "^18.0.5",
    "satori": "^0.12.2",
    "sharp": "^0.34.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "fast-xml-parser": "^5.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.123.0"
  }
}
