---
/**
 * PageFeedback — "Was this page helpful?" vote widget.
 *
 * Rendered by FooterDisclaimer above the doc footer on documentation pages.
 * Votes are fire-and-forget GA4 events (gtag is injected by SeoHead in prod);
 * localStorage enforces one vote per path and restores the voted state.
 */
const path = Astro.url.pathname;
---

<div class="page-feedback" data-page-feedback data-path={path}>
  <div class="page-feedback-prompt" data-feedback-prompt>
    <span class="page-feedback-label">Was this page helpful?</span>
    <div class="page-feedback-actions">
      <button class="page-feedback-btn" type="button" data-feedback-vote="yes" aria-label="Yes, this page was helpful">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>
        </svg>
        <span>Yes</span>
      </button>
      <button class="page-feedback-btn" type="button" data-feedback-vote="no" aria-label="No, this page was not helpful">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/>
        </svg>
        <span>No</span>
      </button>
    </div>
  </div>
  <div class="page-feedback-thanks" data-feedback-thanks hidden>
    <span data-feedback-thanks-text>Thanks for the feedback!</span>
    <a class="page-feedback-issue" href="https://github.com/QAInsights/docs.jmeter.ai/issues/new" target="_blank" rel="noopener noreferrer" data-feedback-issue hidden>
      Tell us what's missing on GitHub
    </a>
  </div>
</div>

<style>
  /* The hidden attribute loses to the display rules below (author CSS beats
     the UA stylesheet), so restate it explicitly for every toggle target. */
  .page-feedback-prompt[hidden],
  .page-feedback-thanks[hidden],
  .page-feedback-issue[hidden] {
    display: none;
  }
  .page-feedback {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 50%, transparent);
    font-size: var(--sl-text-sm);
  }
  .page-feedback-prompt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
  }
  .page-feedback-label {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .page-feedback-actions {
    display: flex;
    gap: 0.5rem;
  }
  .page-feedback-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .page-feedback-btn svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .page-feedback-btn:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }
  .page-feedback-thanks {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    color: var(--sl-color-gray-2);
  }
  .page-feedback-issue {
    color: var(--sl-color-accent);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-decoration: none;
  }
  .page-feedback-issue:hover {
    text-decoration: underline;
  }
</style>

<script>
  (() => {
    if (window.__jmeterPageFeedbackReady) return;
    window.__jmeterPageFeedbackReady = true;

    const STORAGE_KEY = 'jmeter-docs-feedback:v1';

    const readVotes = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : {};
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch {
        return {};
      }
    };

    const writeVote = (path, vote) => {
      try {
        const votes = readVotes();
        votes[path] = vote;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(votes));
      } catch {
        // Storage unavailable (private mode, quota) — feedback still fires.
      }
    };

    const applyVotedState = (widget, vote) => {
      const prompt = widget.querySelector('[data-feedback-prompt]');
      const thanks = widget.querySelector('[data-feedback-thanks]');
      const thanksText = widget.querySelector('[data-feedback-thanks-text]');
      const issueLink = widget.querySelector('[data-feedback-issue]');
      if (!prompt || !thanks) return;
      prompt.hidden = true;
      thanks.hidden = false;
      if (thanksText) {
        thanksText.textContent =
          vote === 'yes'
            ? 'Thanks for the feedback!'
            : "Thanks for the feedback. We'll improve this page.";
      }
      if (issueLink) issueLink.hidden = vote !== 'no';
      widget.querySelectorAll('[data-feedback-vote]').forEach((btn) => {
        btn.setAttribute('disabled', '');
      });
    };

    document.querySelectorAll('[data-page-feedback]').forEach((widget) => {
      const path = widget.dataset.path || window.location.pathname;
      const existing = readVotes()[path];
      if (existing === 'yes' || existing === 'no') {
        applyVotedState(widget, existing);
        return;
      }

      widget.querySelectorAll('[data-feedback-vote]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const vote = btn.dataset.feedbackVote;
          if (vote !== 'yes' && vote !== 'no') return;
          writeVote(path, vote);
          applyVotedState(widget, vote);
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'page_feedback', {
              path,
              rating: vote,
            });
          }
        });
      });
    });
  })();
</script>
