---
/**
 * One-click MCP install buttons for VS Code, VS Code Insiders, and Cursor,
 * plus a "copy mcp.json config" action. Deeplink formats:
 *   VS Code:     vscode:mcp/install?<urlencoded {"name","type":"http","url"}>
 *   Insiders:    vscode-insiders:mcp/install?<same>
 *   Cursor:      cursor://anysphere.cursor-deeplink/mcp/install?name=<n>&config=<base64 {"url"}>
 */
const SERVER_NAME = 'jmeter-docs';
const ENDPOINT = 'https://docs.jmeter.ai/api/mcp';

const vscodeConfig = JSON.stringify({ name: SERVER_NAME, type: 'http', url: ENDPOINT });
const cursorConfig = JSON.stringify({ url: ENDPOINT });

const vscodeUrl = `vscode:mcp/install?${encodeURIComponent(vscodeConfig)}`;
const cursorUrl = `cursor://anysphere.cursor-deeplink/mcp/install?name=${SERVER_NAME}&config=${encodeURIComponent(Buffer.from(cursorConfig).toString('base64'))}`;
const mcpJson = JSON.stringify({ mcpServers: { [SERVER_NAME]: { url: ENDPOINT } } }, null, 2);
---

<div class="mcp-install" data-mcp-install>
  <a href={vscodeUrl} class="mcp-install-btn mcp-install-primary" data-mcp-deeplink="vscode">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
    Add to VS Code
  </a>
  <a href={cursorUrl} class="mcp-install-btn" data-mcp-deeplink="cursor">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
    Add to Cursor
  </a>
  <button
    type="button"
    class="mcp-install-btn"
    data-mcp-copy-config
    data-mcp-target="antigravity"
    data-mcp-config={mcpJson}
    title="Copy config for Antigravity mcp_config.json"
    aria-label="Copy MCP config for Antigravity"
  >
    <svg data-copy-toggle-icon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path data-copy-icon d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
      <path data-check-icon class="is-hidden" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
    </svg>
    <span>Copy for Antigravity</span>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </button>
  <button
    type="button"
    class="mcp-install-btn"
    data-mcp-copy-config
    data-mcp-target="devin"
    data-mcp-config={mcpJson}
    title="Copy MCP config for Devin"
    aria-label="Copy MCP config for Devin"
  >
    <svg data-copy-toggle-icon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path data-copy-icon d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
      <path data-check-icon class="is-hidden" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
    </svg>
    <span>Copy for Devin</span>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </button>
  <button
    type="button"
    class="mcp-install-btn"
    data-mcp-copy-config
    data-mcp-target="mcp_json"
    data-mcp-config={mcpJson}
    aria-label="Copy mcp.json configuration"
  >
    <svg data-copy-toggle-icon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path data-copy-icon d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
      <path data-check-icon class="is-hidden" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
    </svg>
    <span>Copy mcp.json</span>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </button>
</div>

<script>
  (() => {
    if (window.__jmeterMcpInstallReady) return;
    window.__jmeterMcpInstallReady = true;

    const copyTimers = new WeakMap();

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const deeplink = target.closest('[data-mcp-deeplink]');
      if (deeplink) {
        try {
          window.gtag?.('event', 'deeplink_click', {
            deeplink_target: deeplink.getAttribute('data-mcp-deeplink'),
            page: window.location.pathname,
          });
        } catch { /* analytics only */ }
        return;
      }

      const copyBtn = target.closest('[data-mcp-copy-config]');
      if (copyBtn) {
        const status = copyBtn.querySelector('[data-copy-status]');
        const copyIcon = copyBtn.querySelector('[data-copy-icon]');
        const checkIcon = copyBtn.querySelector('[data-check-icon]');
        try {
          await navigator.clipboard.writeText(copyBtn.getAttribute('data-mcp-config') || '');
          if (status) status.textContent = 'Copied MCP config';
          copyIcon?.classList.add('is-hidden');
          checkIcon?.classList.remove('is-hidden');
          try {
            window.gtag?.('event', 'mcp_copy', {
              copy_target: copyBtn.getAttribute('data-mcp-target') || 'mcp_json',
            });
          } catch { /* analytics only */ }
          const prevTimer = copyTimers.get(copyBtn);
          if (prevTimer) clearTimeout(prevTimer);
          copyTimers.set(copyBtn, window.setTimeout(() => {
            if (status) status.textContent = '';
            copyIcon?.classList.remove('is-hidden');
            checkIcon?.classList.add('is-hidden');
          }, 1800));
        } catch {
          if (status) status.textContent = 'Copy failed';
        }
      }
    });
  })();
</script>

<style>
  .mcp-install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0;
  }

  .mcp-install-btn {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    box-sizing: border-box;
    min-height: 2.2rem;
    white-space: nowrap;
    padding: 0.5rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: color 150ms, border-color 150ms, background-color 150ms;
  }

  .mcp-install-btn:hover {
    color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .mcp-install-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .mcp-install-primary {
    color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }

  .mcp-install-btn svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    overflow: visible;
  }

  .mcp-install-btn path.is-hidden {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
