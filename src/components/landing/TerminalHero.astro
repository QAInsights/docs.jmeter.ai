---
const endpoint = 'https://docs.jmeter.ai/api/mcp';

const jsonConfig = JSON.stringify(
  { mcpServers: { 'jmeter-docs': { url: endpoint } } },
  null,
  2
);

const clients = [
  {
    id: 'claude',
    label: 'Claude Code',
    step: 'Run in your terminal',
    lang: 'bash',
    code: `claude mcp add jmeter-docs ${endpoint} --transport http --scope user`,
    hint: 'Restart Claude Code, then verify with /mcp.',
  },
  {
    id: 'cursor',
    label: 'Cursor',
    step: 'Add to .cursor/mcp.json',
    lang: 'json',
    code: jsonConfig,
    hint: 'Reload Cursor to pick up the new server.',
  },
  {
    id: 'qwen',
    label: 'Qwen Code',
    step: 'Add to your MCP settings',
    lang: 'json',
    code: jsonConfig,
    hint: 'Works with any MCP client that accepts a URL.',
  },
  {
    id: 'curl',
    label: 'cURL',
    step: 'Try the endpoint',
    lang: 'bash',
    code: `curl -X POST ${endpoint} \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json, text/event-stream" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'`,
    hint: 'Lists the tools the server exposes.',
  },
];
---

<div class="terminal agent-connect" data-agent-connect>
  <div class="terminal-bar agent-connect-bar">
    <div class="agent-connect-heading">
      <span class="agent-connect-eyebrow">MCP · no API key</span>
      <span class="agent-connect-title">Connect your agent</span>
    </div>
    <div class="agent-tabs" role="tablist" aria-label="MCP client">
      {clients.map((c, i) => (
        <button
          type="button"
          role="tab"
          class="agent-tab"
          id={`agent-tab-${c.id}`}
          aria-controls={`agent-panel-${c.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-agent-tab={c.id}
        >{c.label}</button>
      ))}
    </div>
  </div>
  <div class="terminal-body agent-connect-body">
    {clients.map((c, i) => (
      <div
        class="agent-panel"
        id={`agent-panel-${c.id}`}
        role="tabpanel"
        aria-labelledby={`agent-tab-${c.id}`}
        data-agent-panel={c.id}
        hidden={i !== 0}
      >
        <div class="agent-steps">
          <span class="agent-step"><span class="agent-step-num">1</span>{c.step}</span>
          <span class="agent-step"><span class="agent-step-num">2</span>Ask about JMeter, get grounded answers with a source link</span>
        </div>
        <div class="agent-code">
          <pre class={`agent-pre lang-${c.lang}`}><code>{c.code}</code></pre>
          <button type="button" class="agent-copy" data-agent-copy aria-label="Copy to clipboard" title="Copy">
            <svg class="agent-copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="agent-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          </button>
        </div>
        <p class="agent-hint">{c.hint} <a href="/mcp/">Full setup guide →</a></p>
      </div>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-agent-connect]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-agent-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-agent-panel]'));

    const select = (id: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.agentTab === id;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.agentPanel !== id;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.agentTab!));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next.dataset.agentTab!);
        next.focus();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-agent-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = btn.parentElement?.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          btn.classList.add('is-copied');
          setTimeout(() => btn.classList.remove('is-copied'), 1600);
        } catch {
          /* clipboard unavailable */
        }
      });
    });
  }
</script>
