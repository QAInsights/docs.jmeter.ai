---
/**
 * Interactive Correlation & Practice Sandbox (Apple/Linear Minimalist UI).
 * Progressive disclosure: Flow Canvas + tabbed Inspector Drawer + JMX & Local Server downloads.
 * Adheres strictly to Rule #1 (< 500 lines).
 */
import { CORRELATION_SANDBOX } from '../../lib/tools-config.mjs';
import '../../styles/correlation-sandbox.css';

const { flows } = CORRELATION_SANDBOX;
const initialFlow = flows[0];
---

<div class="cs-sandbox not-content" data-correlation-sandbox>
  <!-- 1. Unified Control Toolbar: Flow Tabs + Target Switcher -->
  <div class="cs-toolbar">
    <div class="cs-tabs" role="tablist" aria-label="Correlation Practice Flows">
      {flows.map((flow, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          class={`cs-tab ${idx === 0 ? 'is-active' : ''}`}
          data-flow-btn={flow.id}
        >
          <span class="cs-tab-num">{flow.index}</span>
          <span class="cs-tab-name">{flow.shortLabel.replace(/^\d+\s*·\s*/, '')}</span>
        </button>
      ))}
    </div>

    <div class="cs-target-segmented" role="group" aria-label="Target Endpoint">
      <button type="button" class="cs-target-btn is-active" data-target-mode="edge" aria-pressed="true" title="Cloud Edge: Hosted 1-thread correlation debugging">
        <span class="cs-status-dot" aria-hidden="true"></span>
        <span>Cloud Edge</span>
      </button>
      <button type="button" class="cs-target-btn" data-target-mode="local" aria-pressed="false" title="Local Target: High-RPS server on localhost:8787">
        <span>localhost:8787</span>
      </button>
    </div>
  </div>

  <!-- 2. Hero Visual Pipeline Canvas with SVG Conduits -->
  <div class="cs-canvas" aria-live="polite">
    <div class="cs-pipeline">
      <!-- Step 1 Node -->
      <div class="cs-node">
        <div class="cs-node-head">
          <div class="cs-node-kicker">
            <span class="cs-step-pill">01 Request</span>
            <span class="cs-method-tag cs-method--get" data-step1-method>GET</span>
            <span class="cs-status-badge cs-status--ok" data-step1-badge>● 200 OK · 14ms</span>
          </div>
          <span class="cs-node-path" data-step1-path>/flow1/login-page</span>
        </div>
        <div class="cs-node-body">
          <div class="cs-node-snippet">
            <span class="cs-snippet-label">Extracted Response Payload</span>
            <pre class="cs-code-preview" data-step1-preview><code>&lt;input name="csrf_token" value="<mark class="cs-hl-token">csrf_live8f92a401b9</mark>" /&gt;
Set-Cookie: <span class="cs-hl-cookie">JMETER_SANDBOX_SID=sid_8f92a...</span></code></pre>
          </div>
        </div>
      </div>

      <!-- Center Conduits + Extractor Bridge -->
      <div class="cs-conduit-bridge">
        <div class="cs-cable cs-cable--in" aria-hidden="true">
          <svg class="cs-cable-svg" preserveAspectRatio="none" viewBox="0 0 60 16">
            <line x1="0" y1="8" x2="52" y2="8" class="cs-cable-track" />
            <line x1="0" y1="8" x2="52" y2="8" class="cs-cable-pulse" />
            <polygon points="52,4 60,8 52,12" class="cs-cable-arrow" />
          </svg>
        </div>

        <div class="cs-extractor-badge" data-extractor-badge>
          <span class="cs-extractor-halo" aria-hidden="true"></span>
          <svg class="cs-extractor-icon" viewBox="0 0 16 16" fill="none" width="13" height="13" aria-hidden="true">
            <path d="M13.5 6.5l-4-4a1.5 1.5 0 00-2.12 0L2.5 7.38a1.5 1.5 0 000 2.12l4 4a1.5 1.5 0 002.12 0l4.88-4.88a1.5 1.5 0 000-2.12z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span class="cs-extractor-text" data-extractor-text>{initialFlow.extractorBadge}</span>
        </div>

        <div class="cs-cable cs-cable--out" aria-hidden="true">
          <svg class="cs-cable-svg" preserveAspectRatio="none" viewBox="0 0 60 16">
            <line x1="0" y1="8" x2="52" y2="8" class="cs-cable-track" />
            <line x1="0" y1="8" x2="52" y2="8" class="cs-cable-pulse" />
            <polygon points="52,4 60,8 52,12" class="cs-cable-arrow" />
          </svg>
        </div>
      </div>

      <!-- Step 2 Node -->
      <div class="cs-node">
        <div class="cs-node-head">
          <div class="cs-node-kicker">
            <span class="cs-step-pill" data-final-step-num>02 Target</span>
            <span class="cs-method-tag cs-method--post" data-final-method>POST</span>
            <span class="cs-status-badge cs-status--verified" data-final-badge>● 200 Verified</span>
          </div>
          <span class="cs-node-path" data-final-path>/flow1/login</span>
        </div>
        <div class="cs-node-body">
          <div class="cs-node-snippet">
            <span class="cs-snippet-label">Correlated Inbound Verification</span>
            <pre class="cs-code-preview" data-final-preview><code>Cookie: <span class="cs-hl-var">&#36;&#123;JMETER_SANDBOX_SID&#125;</span>
Payload: csrf_token=<span class="cs-hl-var">&#36;&#123;csrf_token&#125;</span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Focused Inspector Drawer -->
  <div class="cs-drawer">
    <div class="cs-drawer-head">
      <div class="cs-view-pills" role="tablist" aria-label="Inspector Views">
        <button type="button" class="cs-view-btn is-active" data-view-btn="inspector" role="tab" aria-selected="true">Inspector</button>
        <button type="button" class="cs-view-btn" data-view-btn="steps" role="tab" aria-selected="false">Step Details</button>
        <button type="button" class="cs-view-btn" data-view-btn="jmx" role="tab" aria-selected="false">JMX XML</button>
      </div>
      <div class="cs-mode-segmented" role="group" aria-label="Plan Mode">
        <button type="button" class="cs-mode-btn" data-mode-btn="challenge" aria-pressed="false">Challenge Mode</button>
        <button type="button" class="cs-mode-btn is-active" data-mode-btn="solved" aria-pressed="true">
          <span class="cs-mode-dot" aria-hidden="true"></span>
          <span>Solved Mode</span>
        </button>
      </div>
    </div>

    <!-- Panel 1: Inspector Spec Cards + Live Run -->
    <div class="cs-drawer-body" data-drawer-panel="inspector">
      <dl class="cs-specs">
        <div class="cs-spec">
          <dt class="cs-spec-label">Field to extract</dt>
          <dd class="cs-spec-val" data-spec-field>{initialFlow.extractorConfig.fieldToCheck}</dd>
        </div>
        <div class="cs-spec">
          <dt class="cs-spec-label">Variable name</dt>
          <dd><code class="cs-spec-code cs-spec-code--accent" data-spec-var>${`{${initialFlow.extractorConfig.referenceName}}`}</code></dd>
        </div>
        <div class="cs-spec cs-spec--span">
          <dt class="cs-spec-label">Left boundary</dt>
          <dd><code class="cs-spec-code" data-spec-left>{initialFlow.extractorConfig.leftBoundary}</code></dd>
        </div>
        <div class="cs-spec cs-spec--span">
          <dt class="cs-spec-label">Right boundary</dt>
          <dd><code class="cs-spec-code" data-spec-right>{initialFlow.extractorConfig.rightBoundary}</code></dd>
        </div>
      </dl>

      <div class="cs-test-bar">
        <button type="button" class="cs-test-btn" data-test-step>
          <svg viewBox="0 0 16 16" fill="currentColor" width="12" height="12" aria-hidden="true">
            <path d="M4 2.5l9 5.5-9 5.5V2.5z"/>
          </svg>
          <span>Run Step Verification</span>
        </button>
        <span class="cs-test-hint">Runs the real flow over HTTP against the selected target and reports the actual server verdict.</span>
      </div>

      <!-- Developer Console Result -->
      <div class="cs-console" data-live-result hidden>
        <div class="cs-console-head">
          <div class="cs-mac-dots" aria-hidden="true">
            <span class="cs-mac-dot"></span>
            <span class="cs-mac-dot"></span>
            <span class="cs-mac-dot"></span>
          </div>
          <span class="cs-console-status" data-live-status>200 OK · VERIFIED</span>
          <a class="cs-console-link" data-live-playbook href={initialFlow.playbookUrl} target="_blank" rel="noopener">
            Diagnostic Playbook ↗
          </a>
        </div>
        <pre class="cs-console-pre" data-live-body></pre>
      </div>
    </div>

    <!-- Panel 2: Step Details -->
    <div class="cs-drawer-body" data-drawer-panel="steps" hidden>
      <div class="cs-steps-list" data-steps-list></div>
    </div>

    <!-- Panel 3: JMX XML -->
    <div class="cs-drawer-body" data-drawer-panel="jmx" hidden>
      <div class="cs-jmx-toolbar">
        <span class="cs-jmx-meta" data-jmx-caption>Apache JMeter 5.6.3 · Solved Plan</span>
        <button type="button" class="cs-mini-btn" data-copy-jmx>Copy JMX XML</button>
      </div>
      <pre class="tool-code cs-jmx-pre" data-jmx-output tabindex="0"></pre>
    </div>
  </div>

  <!-- 4. Footer Action Bar -->
  <div class="cs-footer">
    <button
      type="button"
      class="cs-cli-chip"
      data-download-server
      title="Download standalone jmeter-sandbox.mjs and copy start command"
    >
      <span class="cs-cli-prompt">$</span>
      <code>node jmeter-sandbox.mjs</code>
      <span class="cs-cli-badge">Download Server</span>
    </button>

    <div class="cs-footer-actions">
      <span class="cs-toast" data-status aria-live="polite" hidden></span>
      <button type="button" class="cs-btn cs-btn--secondary" data-download-challenge>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" width="14" height="14" aria-hidden="true">
          <path d="M8 2v9m0 0l-3.5-3.5M8 11l3.5-3.5M2 14h12" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Download Challenge .jmx</span>
      </button>
      <button type="button" class="cs-btn cs-btn--primary" data-download-solved>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" width="14" height="14" aria-hidden="true">
          <path d="M8 2v9m0 0l-3.5-3.5M8 11l3.5-3.5M2 14h12" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Download Solved .jmx</span>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    SANDBOX_FLOWS,
    SANDBOX_TARGETS,
    buildSandboxJmxPlan,
    generateLocalSandboxServerScript,
  } from '../../lib/sandbox-jmx-templates.mjs';
  import { getStepPreviews, runLiveFlowVerification } from '../../lib/sandbox-simulator-client';
  import { copyText } from '../../lib/tools-utils.mjs';

  function downloadFile(filename: string, content: string, mime = 'application/xml') {
    const blob = new Blob([content], { type: `${mime};charset=utf-8` });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';

    let activeFlowId = 'flow1';
    let activeMode: 'challenge' | 'solved' = 'solved';
    let activeTarget: 'edge' | 'local' = 'edge';

    const step1Method = root.querySelector('[data-step1-method]') as HTMLElement | null;
    const step1Path = root.querySelector('[data-step1-path]') as HTMLElement | null;
    const step1Badge = root.querySelector('[data-step1-badge]') as HTMLElement | null;
    const step1Preview = root.querySelector('[data-step1-preview]') as HTMLElement | null;
    const extractorBadge = root.querySelector('[data-extractor-badge]') as HTMLElement | null;
    const extractorText = root.querySelector('[data-extractor-text]') as HTMLElement | null;
    const finalStepNum = root.querySelector('[data-final-step-num]') as HTMLElement | null;
    const finalMethod = root.querySelector('[data-final-method]') as HTMLElement | null;
    const finalPath = root.querySelector('[data-final-path]') as HTMLElement | null;
    const finalBadge = root.querySelector('[data-final-badge]') as HTMLElement | null;
    const finalPreview = root.querySelector('[data-final-preview]') as HTMLElement | null;

    const specField = root.querySelector('[data-spec-field]') as HTMLElement | null;
    const specLeft = root.querySelector('[data-spec-left]') as HTMLElement | null;
    const specRight = root.querySelector('[data-spec-right]') as HTMLElement | null;
    const specVar = root.querySelector('[data-spec-var]') as HTMLElement | null;
    const stepsList = root.querySelector('[data-steps-list]') as HTMLElement | null;
    const jmxOutput = root.querySelector('[data-jmx-output]') as HTMLElement | null;
    const jmxCaption = root.querySelector('[data-jmx-caption]') as HTMLElement | null;
    const liveResult = root.querySelector('[data-live-result]') as HTMLElement | null;
    const liveStatus = root.querySelector('[data-live-status]') as HTMLElement | null;
    const livePlaybook = root.querySelector('[data-live-playbook]') as HTMLAnchorElement | null;
    const liveBody = root.querySelector('[data-live-body]') as HTMLElement | null;
    const statusToast = root.querySelector('[data-status]') as HTMLElement | null;

    function flashToast(msg: string) {
      if (!statusToast) return;
      statusToast.textContent = msg;
      statusToast.hidden = false;
      setTimeout(() => { statusToast.hidden = true; }, 2200);
    }

    function render() {
      const flow = SANDBOX_FLOWS.find((f) => f.id === activeFlowId) || SANDBOX_FLOWS[0];
      const first = flow.steps[0];
      const last = flow.steps[flow.steps.length - 1];
      const isSolved = activeMode === 'solved';
      const previews = getStepPreviews(activeFlowId, isSolved);

      root.querySelectorAll<HTMLButtonElement>('[data-target-mode]').forEach((b) => {
        const sel = b.dataset.targetMode === activeTarget;
        b.classList.toggle('is-active', sel);
        b.setAttribute('aria-pressed', sel ? 'true' : 'false');
      });

      if (step1Method) {
        step1Method.textContent = first.method;
        step1Method.className = `cs-method-tag cs-method--${first.method.toLowerCase()}`;
      }
      if (step1Path) {
        step1Path.textContent = first.path;
        step1Path.title = first.path;
      }
      if (step1Badge) step1Badge.textContent = first.statusBadge;
      if (step1Preview) step1Preview.innerHTML = `<code>${previews.s1}</code>`;

      if (extractorText) {
        extractorText.textContent = isSolved ? flow.extractorBadge : 'Missing Extractor (Uncorrelated)';
      }
      if (extractorBadge) {
        extractorBadge.classList.toggle('is-broken', !isSolved);
      }

      if (finalStepNum) finalStepNum.textContent = `0${flow.steps.length} Target`;
      if (finalMethod) {
        finalMethod.textContent = last.method;
        finalMethod.className = `cs-method-tag cs-method--${last.method.toLowerCase()}`;
      }
      if (finalPath) {
        finalPath.textContent = last.path;
        finalPath.title = last.path;
      }
      if (finalBadge) {
        finalBadge.textContent = isSolved ? '● 200 Verified' : '● 403 Challenge Failed';
        finalBadge.className = `cs-status-badge ${isSolved ? 'cs-status--verified' : 'cs-status--failed'}`;
      }
      if (finalPreview) finalPreview.innerHTML = `<code>${previews.s2}</code>`;

      if (specField) specField.textContent = flow.extractorConfig.fieldToCheck;
      if (specLeft) specLeft.textContent = flow.extractorConfig.leftBoundary || flow.extractorConfig.jsonPath || '-';
      if (specRight) specRight.textContent = flow.extractorConfig.rightBoundary || '-';
      if (specVar) specVar.textContent = `\${${flow.extractorConfig.referenceName}}`;

      if (jmxCaption) {
        jmxCaption.textContent = `Apache JMeter 5.6.3 · ${isSolved ? 'Solved Correlated Plan' : 'Challenge Broken Plan'}`;
      }
      if (jmxOutput) {
        jmxOutput.textContent = buildSandboxJmxPlan(flow.id, activeMode, activeTarget);
      }

      if (stepsList) {
        stepsList.innerHTML = flow.steps
          .map((s, i) => `
            <div class="cs-step-row">
              <span class="cs-step-row-num">Step ${i + 1}</span>
              <span class="cs-method-tag cs-method--${s.method.toLowerCase()}">${s.method}</span>
              <code class="cs-step-row-path">${s.path}</code>
              <span class="cs-step-row-desc">${s.summary}</span>
            </div>
          `).join('');
      }

      // Params changed while console is open — mark stale instead of auto-firing
      // real HTTP calls on every toggle (respects the edge rate limit).
      if (liveResult && !liveResult.hidden && liveStatus) {
        liveStatus.textContent = '·· RE-RUN ··';
        liveStatus.className = 'cs-console-status';
      }
    }

    let liveBusy = false;
    let lastRunAt = 0;
    const testBtn = root.querySelector('[data-test-step]') as HTMLButtonElement | null;

    async function runLiveVerification() {
      if (!liveResult || !liveStatus || !liveBody) return;
      if (liveBusy) return;
      if (Date.now() - lastRunAt < 2000) {
        flashToast('Verification cooldown — wait a moment');
        return;
      }
      liveBusy = true;
      lastRunAt = Date.now();
      if (testBtn) testBtn.disabled = true;

      const flow = SANDBOX_FLOWS.find((f) => f.id === activeFlowId) || SANDBOX_FLOWS[0];
      const target = SANDBOX_TARGETS[activeTarget];
      liveResult.hidden = false;
      liveStatus.textContent = '… RUNNING';
      liveStatus.className = 'cs-console-status';
      liveBody.textContent = `Sending requests to ${target.baseUrl} …`;

      try {
        const res = await runLiveFlowVerification(activeFlowId, activeMode, target.baseUrl);
        const ok = res.ok;
        liveStatus.textContent =
          res.status === 429
            ? '429 · RATE LIMITED — honour Retry-After'
            : `${res.status} ${ok ? '· CORRELATION VERIFIED' : '· CORRELATION FAILED'}`;
        liveStatus.className = `cs-console-status ${ok ? 'cs-status--ok-text' : 'cs-status--err-text'}`;
        if (livePlaybook) livePlaybook.href = flow.playbookUrl;
        const stepLines = res.steps
          .map((s) => `${s.ok ? '✓' : '✗'} ${s.label} → ${s.status} (${s.ms}ms)`)
          .join('\n');
        liveBody.textContent = `${stepLines}\n\n${res.body}`;
      } catch (e) {
        liveStatus.textContent = 'ERR · NETWORK UNREACHABLE';
        liveStatus.className = 'cs-console-status cs-status--err-text';
        const hint =
          activeTarget === 'local'
            ? 'Is the local server running? Download it below, then: node jmeter-sandbox.mjs'
            : 'The edge endpoint could not be reached — check connectivity or switch to Localhost.';
        liveBody.textContent = `Could not reach ${target.baseUrl}\n${hint}\n\n${(e as Error)?.message || e}`;
      } finally {
        liveBusy = false;
        if (testBtn) testBtn.disabled = false;
      }
    }

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const flowBtn = t.closest<HTMLButtonElement>('[data-flow-btn]');
      if (flowBtn) {
        activeFlowId = flowBtn.dataset.flowBtn || 'flow1';
        root.querySelectorAll<HTMLButtonElement>('[data-flow-btn]').forEach((b) => {
          const sel = b === flowBtn;
          b.classList.toggle('is-active', sel);
          b.setAttribute('aria-selected', sel ? 'true' : 'false');
        });
        render();
        return;
      }

      const targetBtn = t.closest<HTMLButtonElement>('[data-target-mode]');
      if (targetBtn) {
        activeTarget = (targetBtn.dataset.targetMode as 'edge' | 'local') || 'edge';
        render();
        flashToast(activeTarget === 'edge' ? 'Switched to Cloud Edge' : 'Switched to Localhost:8787');
        return;
      }

      const modeBtn = t.closest<HTMLButtonElement>('[data-mode-btn]');
      if (modeBtn) {
        activeMode = (modeBtn.dataset.modeBtn as 'challenge' | 'solved') || 'solved';
        root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]').forEach((b) => {
          const sel = b === modeBtn;
          b.classList.toggle('is-active', sel);
          b.setAttribute('aria-pressed', sel ? 'true' : 'false');
        });
        render();
        flashToast(activeMode === 'solved' ? 'Solved Mode (Correlated Plan)' : 'Challenge Mode (Broken Plan)');
        return;
      }

      const viewBtn = t.closest<HTMLButtonElement>('[data-view-btn]');
      if (viewBtn) {
        const view = viewBtn.dataset.viewBtn;
        root.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((b) => {
          const sel = b === viewBtn;
          b.classList.toggle('is-active', sel);
          b.setAttribute('aria-selected', sel ? 'true' : 'false');
        });
        root.querySelectorAll<HTMLElement>('[data-drawer-panel]').forEach((p) => {
          p.hidden = p.dataset.drawerPanel !== view;
        });
        return;
      }

      if (t.closest('[data-test-step]')) {
        runLiveVerification();
        return;
      }

      if (t.closest('[data-copy-jmx]')) {
        const jmx = buildSandboxJmxPlan(activeFlowId, activeMode, activeTarget);
        copyText(jmx).then(() => flashToast('JMX XML copied to clipboard'));
        return;
      }

      if (t.closest('[data-download-challenge]')) {
        const jmx = buildSandboxJmxPlan(activeFlowId, 'challenge', activeTarget);
        downloadFile(`jmeter-${activeFlowId}-challenge.jmx`, jmx);
        flashToast('Downloaded Challenge .jmx');
        return;
      }

      if (t.closest('[data-download-solved]')) {
        const jmx = buildSandboxJmxPlan(activeFlowId, 'solved', activeTarget);
        downloadFile(`jmeter-${activeFlowId}-solved.jmx`, jmx);
        flashToast('Downloaded Solved .jmx');
        return;
      }

      if (t.closest('[data-download-server]')) {
        const script = generateLocalSandboxServerScript();
        downloadFile('jmeter-sandbox.mjs', script, 'application/javascript');
        copyText('node jmeter-sandbox.mjs').then(() => {
          flashToast('Copied "node jmeter-sandbox.mjs" & downloaded server script');
        });
        return;
      }
    });

    render();
  }

  document.querySelectorAll<HTMLElement>('[data-correlation-sandbox]').forEach(init);
</script>
