{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-jmeter-ai",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [{ "binding": "SESSION", "id": "1a5790178b7e43958a9e4718665575ed" }],
  // Workers Logs + traces in the dashboard (free). Watch for CPU-limit
  // errors (1102) and free-tier request-cap errors (1027) after cutover.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // Public build-time config (Algolia DocSearch) — safe to commit.
  // Secrets (GOOGLE_GENERATIVE_AI_API_KEY, TURNSTILE_SECRET_KEY,
  // UPSTASH_REDIS_REST_URL/TOKEN) are set via `wrangler secret put`.
  "vars": {}
}
